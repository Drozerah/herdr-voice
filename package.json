{
  "name": "herdr-voice",
  "version": "1.0.0-alpha.1",
  "description": "Real-time TTS Voice Plugin for Herdr agents",
  "type": "module",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=18.11.0"
  },
  "scripts": {
    "precommit": "npm run lint && npm test",
    "dev": "NODE_ENV=development esbuild src/index.js --bundle --platform=node --target=node18 --outfile=dist/index.js --watch",
    "build": "NODE_ENV=production esbuild src/index.js --bundle --platform=node --target=node18 --minify --outfile=dist/index.js",
    "test": "NODE_ENV=test node --test src/index.test.js src/config.test.js src/logger.test.js bin/mock-tts-server.test.js bin/version-sync.test.js",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "mock-tts": "NODE_ENV=development nodemon bin/mock-tts-server.js"
  },
  "standard": {
    "ignore": [
      "dist/**",
      "tmp/**"
    ]
  },
  "keywords": [
    "herdr",
    "plugin",
    "tts",
    "voice",
    "audio"
  ],
  "author": "Thomas Gauthier",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.9",
    "standard": "^17.1.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.7",
    "smol-toml": "^1.7.1"
  }
}
